+
+inline std::atomic<uint64_t>& LockTimingMeasurementStartNs() {
+  static std::atomic<uint64_t> start_ns(0);
+  return start_ns;
+}
+
+inline std::atomic<uint64_t>& LockTimingMeasurementEndNs() {
+  static std::atomic<uint64_t> end_ns(0);
