+/* FlexGuard regression test: trylock, nesting and contended publication. */
+#include "flexguard.h"
+#include <assert.h>
+
+#define WORKERS 8
+#define ITERATIONS 20000
+
+static flexguard_lock_t lock, outer;
+static unsigned long counter, inverse = ~0UL;
+static pthread_barrier_t start;
+extern num_preempted_cs_t *num_preempted_cs;
+
+#ifndef BPF
+static atomic_bool stop;
+
+/* Exercise transitions between MCS spinning and futex blocking without BPF. */
+static void *toggle_blocking(void *unused)
+{
+    while (!atomic_load_explicit(&stop, memory_order_relaxed))
+    {
+        __atomic_store_n(num_preempted_cs, 1, __ATOMIC_RELAXED);
+        sched_yield();
+        __atomic_store_n(num_preempted_cs, 0, __ATOMIC_RELAXED);
+        sched_yield();
+    }
+    return NULL;
+}
+#endif
+
+static void *worker(void *unused)
+{
+    pthread_barrier_wait(&start);
+    for (int i = 0; i < ITERATIONS; ++i)
+    {
+        if (i % 8 != 0 || flexguard_trylock(&lock) == EBUSY)
+            flexguard_lock(&lock);
+        assert(inverse == ~counter);
+        ++counter;
+        inverse = ~counter;
+        flexguard_unlock(&lock);
+    }
+    return NULL;
+}
+
+int main(void)
+{
+    pthread_t workers[WORKERS];
+    assert(flexguard_init(&lock) == 0);
+    assert(flexguard_init(&outer) == 0);
+
+    assert(flexguard_trylock(&outer) == 0);
+    assert(flexguard_trylock(&outer) == EBUSY);
+    flexguard_lock(&lock);
+    assert(flexguard_trylock(&lock) == EBUSY);
+    flexguard_unlock(&lock);
+    assert(flexguard_trylock(&lock) == 0);
+    flexguard_unlock(&lock);
+    flexguard_unlock(&outer);
+
+    assert(pthread_barrier_init(&start, NULL, WORKERS) == 0);
+#ifndef BPF
+    pthread_t toggler;
+    assert(pthread_create(&toggler, NULL, toggle_blocking, NULL) == 0);
+#endif
+    for (int i = 0; i < WORKERS; ++i)
+        assert(pthread_create(&workers[i], NULL, worker, NULL) == 0);
+    for (int i = 0; i < WORKERS; ++i)
+        assert(pthread_join(workers[i], NULL) == 0);
+#ifndef BPF
+    atomic_store_explicit(&stop, true, memory_order_relaxed);
+    assert(pthread_join(toggler, NULL) == 0);
+#endif
+    assert(counter == WORKERS * ITERATIONS);
+    assert(inverse == ~counter);
+    pthread_barrier_destroy(&start);
+    flexguard_destroy(&lock);
+    flexguard_destroy(&outer);
+    printf("FlexGuard regression passed: %lu acquisitions\n", counter);
+    return 0;
+}
