+bool DBImpl::Writer::AwaitTurn() NO_THREAD_SAFETY_ANALYSIS {
+  if (!event.Active()) {
+    cv.Wait();
+    return true;
+  }
+
+  // The reason code has to be published before the mutex is given up, and the
+  // sleep state the wake is routed from has to be published after it, which is
+  // why the two halves sit on either side of the release.
+  event.Arm();
+  mu->Unlock();
+  if (event.Wait() == port::WriterEvent::kCompleted) {
+    return false;
+  }
+  event.Relock();
+  return true;
+}
+
+void DBImpl::Writer::PostCompleted() {
+  if (event.Active()) {
+    event.PostCompleted();
+    return;
+  }
+  cv.Signal();
+}
+
+void DBImpl::Writer::PostLeader() {
+  if (event.Active()) {
+    event.PostLeader();
+    return;
+  }
+  cv.Signal();
+}
