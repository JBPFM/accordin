+// Resolving a binding consults a process-wide registry keyed by mutex address,
+// which is far too much work to repeat for every writer, and the answer is a
+// property of the mutex that cannot change while it exists. std::call_once
+// makes the resolution single without putting a lock on the path that reads it.
+inline void* Mutex::WriterEventBinding() {
+  std::call_once(writer_event_once_, [this]() {
+    if (direct_ != nullptr) {
+      if (!DirectWriterEventAvailable() ||
+          mcs_tas_accordin_direct_writer_event_bind(
+              direct_, &writer_event_binding_) != 0) {
+        writer_event_binding_ = nullptr;
+      }
+      return;
+    }
+    if (!HookWriterEventAvailable() ||
+        accordin_writer_event_bind(mu_.native_handle(),
+                                   &writer_event_binding_) != 0) {
+      writer_event_binding_ = nullptr;
+    }
+  });
+  return writer_event_binding_;
+}
