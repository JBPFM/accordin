+// A per-waiter wake event for leader/follower queues.
+//
+// A condition variable conflates the two reasons such a queue wakes a waiter
+// for. This splits them into a reason code the waiter blocks on: a waiter whose
+// work the queue head already did returns without re-acquiring the mutex, and a
+// waiter promoted to head re-acquires it carrying the admission decision its
+// wake was granted.
+//
+// The event is inert unless the backend library exports it and the run asks for
+// it; callers keep their condition variable whenever Active() says no, so the
+// off path is the path this file always had.
+class WriterEvent {
+ public:
+  enum WakeReason { kCompleted = 0, kBecomeLeader = 1 };
+
+  // Costs one flag test per construction when the feature is off, and one
+  // relaxed load plus a struct write when it is on: the mutex answered which
+  // backend it uses and what to bind to once, at its first writer.
+  explicit WriterEvent(Mutex* mu) : mu_(mu) {
+    if (!WriterEventEnabledByEnv()) {
+      return;
+    }
+    void* binding = mu->WriterEventBinding();
+    if (binding == nullptr) {
+      return;
+    }
+    direct_ = mu->direct_ != nullptr;
+    active_ = (direct_ ? mcs_tas_accordin_direct_writer_event_init(Storage(),
+                                                                   binding)
+                       : accordin_writer_event_init(Storage(), binding)) == 0;
+    if (active_ && CvStatsEnabled()) {
+      stats_ = CvLabelStatsFor(kWriterEventCvLabel);
+    }
+  }
+
+  // Nothing to release: the event lives in the storage below for exactly as
+  // long as this object does.
+  ~WriterEvent() = default;
+
+  WriterEvent(const WriterEvent&) = delete;
+  WriterEvent& operator=(const WriterEvent&) = delete;
+
+  bool Active() const { return active_; }
+
+  // Declares the waiter unreleased. REQUIRES: the mutex is held, so that no
+  // post can land before the declaration and be overwritten by it.
+  //
+  // A failure here would leave the waiter about to block on a reason word it
+  // never claimed, which no caller can recover from, so it is fatal.
+  void Arm() {
+    const int ret = direct_ ? mcs_tas_accordin_direct_writer_event_arm(Storage())
+                            : accordin_writer_event_arm(Storage());
+    if (ret != 0) {
+      WriterEventFatal("arm", ret);
+    }
+  }
+
+  // Blocks until a post publishes a reason. REQUIRES: the mutex is released.
+  //
+  // Anything the backend reports that is not one of the two reasons is read as
+  // kBecomeLeader, which is the only mapping that cannot lose a write. A
+  // caller told kBecomeLeader re-acquires the mutex and re-reads the queue, so
+  // a writer that was in fact already completed still finds its own state and
+  // returns the status the leader published; a caller told kCompleted returns
+  // immediately on the strength of that report, and if it was wrong it returns
+  // a status nobody set for a batch nobody wrote.
+  WakeReason Wait() {
+    const uint64_t wait_start_ns = LockTimingNowNs();
+    const int reason = direct_
+                           ? mcs_tas_accordin_direct_writer_event_wait(Storage())
+                           : accordin_writer_event_wait(Storage());
+    if (stats_ != nullptr) {
+      RecordCvWait(stats_, LockTimingNowNs() - wait_start_ns);
+    }
+    WriterEventStats& counters = WriterEventStatsRef();
+    if (reason == kCompleted) {
+      counters.completed_wakes.fetch_add(1, std::memory_order_relaxed);
+      return kCompleted;
+    }
+    counters.leader_wakes.fetch_add(1, std::memory_order_relaxed);
+    return kBecomeLeader;
+  }
+
+  // Re-acquires the mutex for a waiter this event made head of the queue.
+  // Bypasses Mutex::Lock() because the admission decision the wake carried
+  // belongs to this acquisition, so the hold sample is opened here instead.
+  //
+  // The caller runs the queue's critical section next, so a failure that left
+  // the mutex unheld has no safe continuation and is fatal.
+  void Relock() {
+    const int ret = direct_
+                        ? mcs_tas_accordin_direct_writer_event_relock(Storage())
+                        : accordin_writer_event_relock(Storage());
+    if (ret != 0) {
+      WriterEventFatal("relock", ret);
+    }
+    mu_->StartLockTimingHold();
+  }
+
+  // Releases a waiter whose work the caller already did.
+  //
+  // REQUIRES: the result is already published. This is the caller's last access
+  // to the event: the waiter may return and destroy it as the reason lands.
+  void PostCompleted() {
+    WriterEventStatsRef().completed_posts.fetch_add(1,
+                                                    std::memory_order_relaxed);
