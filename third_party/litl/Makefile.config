# Format: {A}_{S}
# A = algorithm name, lowercase, without space (must match the src/*.c and src/*.h name)
# S = waiting strategy. original = hardcoded in the algorithm (see README), otherwise spinlock/spin_then_park/park

ALGORITHMS=mcs_spinlock      \
mcsepfl_original             \
mcs_spin_then_park           \
mcstp_original               \
spinlock_original            \
spinlockepfl_original        \
malthusian_spinlock          \
malthusian_spin_then_park    \
ttas_original                \
ttasepfl_original            \
ticket_original              \
ticketepfl_original          \
clh_spinlock                 \
clh_spin_then_park           \
clhepfl_original             \
backoff_original             \
empty_original               \
pthreadinterpose_original    \
pthreadadaptive_original     \
concurrency_original	     \
htlockepfl_original          \
alockepfl_original           \
hmcs_original                \
hyshmcs_original			 \
cbomcs_spinlock 			 \
cbomcs_spin_then_park 		 \
cptltkt_original 			 \
ctkttkt_original 			 \
partitioned_original         \
mutexee_original

ACCORDIN_ALGORITHMS=mcsaccordin_original mcstasaccordin_original

# Baseline algorithms that manage their own storage. They share the direct
# front end in src/directlock.c and need neither CLHT, ssmem nor PAPI.
# Algorithm names carry no underscore: the build splits on it to recover the
# waiting policy.
LITL_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
LITL_REPO_ROOT := $(abspath $(LITL_DIR)/../..)
LIBVSYNC_DIR ?= $(LITL_REPO_ROOT)/third_party/libvsync
FLEXGUARD_DIR ?= $(LITL_REPO_ROOT)/bench/flexguard

DIRECT_ALGORITHM_NAMES=gcr cna \
mbmcs mbmcstas mbmcstastse mbmcstasnext mbmcstasnexttse \
mbclh mbtwa mbhapax mbreciprocating

# FlexGuard links its own runtime archive, which is built out of the FlexGuard
# checkout. It joins the list once that archive is present, or on demand with
# FLEXGUARD=1, which also builds the archive.
ifneq ($(or $(wildcard $(FLEXGUARD_DIR)/libsync.a),$(FLEXGUARD)),)
DIRECT_ALGORITHM_NAMES += flexguard
endif

DIRECT_ALGORITHMS=$(addsuffix _original,$(DIRECT_ALGORITHM_NAMES))
ALGORITHMS += $(ACCORDIN_ALGORITHMS) $(DIRECT_ALGORITHMS)
