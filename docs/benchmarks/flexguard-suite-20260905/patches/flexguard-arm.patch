 static int is_critical_thread(struct task_struct *task, flexguard_qnode_ptr qnode)
 {
+#if defined(__TARGET_ARCH_arm64)
+    /* Nested acquisitions must not hide an already-held outer lock. */
+    if (qnode->cs_counter > 1)
+        return 1;
+
+    struct pt_regs *regs = (struct pt_regs *)bpf_task_pt_regs(task);
+    u64 pc = BPF_CORE_READ(regs, pc);
+
+    /*
+     * The intervals start immediately after STLXR, including its retry
+     * branch, and end after the monitor state has been published. w9 is
+     * the store status throughout each interval; x10 is the predecessor
+     * throughout the enqueue interval. No compiler-generated code lies
+     * between these labels.
+     */
+    if ((u64)addresses.fastpath <= pc && pc < (u64)addresses.fastpath_out)
+        return (u32)BPF_CORE_READ(regs, regs[9]) == 0;
+
+    if ((u64)addresses.enqueue <= pc && pc < (u64)addresses.enqueue_out)
+        return (u32)BPF_CORE_READ(regs, regs[9]) == 0 &&
+               (BPF_CORE_READ(regs, regs[10]) == 0 || qnode->waiting == 0);
+
+    return qnode->monitor_state == FG_CRITICAL ||
+           (qnode->monitor_state == FG_WAITING && qnode->waiting == 0);
+#elif defined(__TARGET_ARCH_x86)
 	u64 user_stack[MAX_STACK_TRACE_DEPTH];
