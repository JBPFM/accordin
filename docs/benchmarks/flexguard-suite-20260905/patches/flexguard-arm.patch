+#if defined(__GNUC__) && !defined(__clang__)
+#define FG_NOINLINE __attribute__((noinline, noclone))
+#else
+#define FG_NOINLINE __attribute__((noinline))
+#endif
+
+/*
+ * w9 is the STLXR result (zero on success). The monitor only reads it
+ * inside the labeled assembly interval, before ownership is published.
+ * Use ARMv8.0 LL/SC so this also works on CPUs without LSE atomics.
+ */
+static FG_NOINLINE int arm_try_acquire(flexguard_lock_t *the_lock,
+                                      flexguard_qnode_ptr qnode)
+{
+    int result;
+    __asm__ volatile(
+        "1: ldaxr w9, [%[lock]]\n"
+        "cbnz w9, 2f\n"
+        "mov w10, #1\n"
+        "stlxr w9, w10, [%[lock]]\n"
+#ifdef BPF
+        "fg_fastpath:\n"
+#endif
+        "cbnz w9, 1b\n"
+#ifdef BPF
+        "stlrb wzr, [%[monitor]]\n" // FG_CRITICAL
+        "fg_fastpath_out:\n"
+#endif
+        "mov %w[result], #0\n"
+        "b 3f\n"
+        "2: clrex\n"
+        "mov %w[result], #1\n"
+        "3:\n"
+        : [result] "=&r"(result)
+        : [lock] "r"(&the_lock->lock_value)
+#ifdef BPF
+          , [monitor] "r"(&qnode->monitor_state)
+#endif
+        : "x9", "x10", "memory");
+    return result;
+}
+
+static FG_NOINLINE flexguard_qnode_ptr arm_enqueue(flexguard_lock_t *the_lock,
+                                                   flexguard_qnode_ptr qnode)
+{
+    register flexguard_qnode_ptr pred __asm__("x10");
+    __asm__ volatile(
+        "1: ldaxr x10, [%[queue]]\n"
+        "stlxr w9, %[node], [%[queue]]\n"
+#ifdef BPF
+        "fg_enqueue:\n"
+#endif
+        "cbnz w9, 1b\n"
+        "cbnz x10, 2f\n"
+        "stlrb wzr, [%[waiting]]\n" // Queue head does not wait for a predecessor.
+        "2:\n"
+#ifdef BPF
+        "stlrb %w[waiting_state], [%[monitor]]\n"
+        "fg_enqueue_out:\n"
+#endif
+        : "=&r"(pred)
+        : [queue] "r"(&the_lock->queue), [node] "r"(qnode),
+          [waiting] "r"(&qnode->waiting)
+#ifdef BPF
+          , [monitor] "r"(&qnode->monitor_state), [waiting_state] "r"(FG_WAITING)
+#endif
+        : "x9", "memory");
+    return pred;
+}
+
