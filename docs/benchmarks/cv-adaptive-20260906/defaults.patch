+static uint64_t monotonic_ns(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now))
+        abort();
+    return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
