+// Condition variable blocking is attributed to a construction-site label
+// instead of a CondVar instance, because writer condition variables are created
+// per Write() call and would otherwise churn the table.
+constexpr int kCvLabelSlots = 8;
+constexpr int kCvWaitBuckets = 32;
+
+// Bucket i > 0 holds wait durations in [2^(i-1), 2^i) nanoseconds; the last
+// bucket absorbs everything above its lower bound.
+inline int CvWaitBucketIndex(uint64_t wait_ns) {
+  if (wait_ns == 0) {
+    return 0;
+  }
+  const int index = 64 - __builtin_clzll(wait_ns);
+  return index >= kCvWaitBuckets ? kCvWaitBuckets - 1 : index;
+}
+
+// Static storage zero-initializes every counter before any thread runs.
+struct CvLabelStats {
+  std::atomic<const char*> label;
+  std::atomic<uint64_t> wait_count;
+  std::atomic<uint64_t> signal_count;
+  std::atomic<uint64_t> broadcast_count;
+  std::atomic<uint64_t> broadcast_fanout;
+  std::atomic<uint64_t> wait_ns_total;
+  std::atomic<uint64_t> wait_buckets[kCvWaitBuckets];
+};
+
+inline CvLabelStats* CvLabelStatsTable() {
+  static CvLabelStats table[kCvLabelSlots];
+  return table;
+}
+
+inline bool CvStatsEnabled() {
+  static const bool enabled =
+      EnvFlagEnabled("LEVELDB_CV_STATS", LockTimingEnabledByEnv());
+  return enabled;
+}
+
+// Labels come from string literals, so the pointer comparison hits first; the
+// string comparison only covers duplicated literals across translation units.
+inline CvLabelStats* CvLabelStatsFor(const char* label) {
+  if (label == nullptr) {
+    label = "other";
+  }
+  CvLabelStats* table = CvLabelStatsTable();
+  for (int i = 0; i < kCvLabelSlots; ++i) {
+    const char* existing = table[i].label.load(std::memory_order_acquire);
+    if (existing != nullptr) {
+      if (existing == label || std::strcmp(existing, label) == 0) {
+        return &table[i];
+      }
+      continue;
+    }
+    const char* expected = nullptr;
+    if (table[i].label.compare_exchange_strong(expected, label,
+                                               std::memory_order_acq_rel,
+                                               std::memory_order_acquire)) {
+      return &table[i];
+    }
+    if (expected == label || std::strcmp(expected, label) == 0) {
+      return &table[i];
+    }
+  }
+  return nullptr;
+}
+
+inline void RecordCvWait(CvLabelStats* stats, uint64_t wait_ns) {
+  stats->wait_count.fetch_add(1, std::memory_order_relaxed);
+  stats->wait_ns_total.fetch_add(wait_ns, std::memory_order_relaxed);
+  stats->wait_buckets[CvWaitBucketIndex(wait_ns)].fetch_add(
+      1, std::memory_order_relaxed);
+}
+
+inline void PrintCvStats() {
+  if (!CvStatsEnabled()) {
+    return;
+  }
+  std::fprintf(stdout, "leveldb_cv_stats_gate: LEVELDB_CV_STATS\n");
+  std::fprintf(stdout, "leveldb_cv_stats_gate_fallback: LEVELDB_LOCK_TIMING\n");
+  std::fprintf(stdout, "leveldb_cv_stats_scope: process_cumulative\n");
+  std::fprintf(stdout, "leveldb_cv_wait_histogram_unit: log2_ns\n");
+  CvLabelStats* table = CvLabelStatsTable();
+  for (int i = 0; i < kCvLabelSlots; ++i) {
+    const char* label = table[i].label.load(std::memory_order_acquire);
+    if (label == nullptr) {
+      continue;
+    }
+    std::fprintf(
+        stdout, "leveldb_cv_wait_count{label=%s}: %llu\n", label,
+        static_cast<unsigned long long>(
+            table[i].wait_count.load(std::memory_order_relaxed)));
+    std::fprintf(
+        stdout, "leveldb_cv_wait_ns_total{label=%s}: %llu\n", label,
+        static_cast<unsigned long long>(
+            table[i].wait_ns_total.load(std::memory_order_relaxed)));
+    std::fprintf(
+        stdout, "leveldb_cv_signal_count{label=%s}: %llu\n", label,
+        static_cast<unsigned long long>(
+            table[i].signal_count.load(std::memory_order_relaxed)));
+    std::fprintf(
+        stdout, "leveldb_cv_broadcast_count{label=%s}: %llu\n", label,
+        static_cast<unsigned long long>(
+            table[i].broadcast_count.load(std::memory_order_relaxed)));
+    std::fprintf(
+        stdout, "leveldb_cv_broadcast_fanout{label=%s}: %llu\n", label,
+        static_cast<unsigned long long>(
+            table[i].broadcast_fanout.load(std::memory_order_relaxed)));
+    std::fprintf(stdout, "leveldb_cv_wait_histogram{label=%s}:", label);
+    for (int bucket = 0; bucket < kCvWaitBuckets; ++bucket) {
+      const uint64_t count =
+          table[i].wait_buckets[bucket].load(std::memory_order_relaxed);
+      if (count != 0) {
+        std::fprintf(stdout, " %d:%llu", bucket,
+                     static_cast<unsigned long long>(count));
+      }
+    }
+    std::fprintf(stdout, "\n");
+  }
+  std::fflush(stdout);
+}
 
