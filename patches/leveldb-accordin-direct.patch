+// Ends the process on a writer-event call that cannot fail and did. Every such
+// call is a step of a protocol whose remaining steps assume it succeeded, and
+// the two that matter leave the caller either running a critical section
+// without the mutex or waiting for a reason nobody will publish.
+inline void WriterEventFatal(const char* what, int ret) {
+  std::fprintf(stderr, "leveldb: writer event %s failed with %d\n", what, ret);
+  std::fflush(stderr);
+  std::abort();
