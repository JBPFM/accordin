+      mcs_tas_accordin_direct_writer_event_post_completed(Storage());
+      return;
+    }
+    accordin_writer_event_post_completed(Storage());
+  }
+
+  // Hands the head of the queue over. As with a completed post, this is the
+  // caller's last access to the event.
+  void PostLeader() {
+    WriterEventStatsRef().leader_posts.fetch_add(1, std::memory_order_relaxed);
+    if (direct_) {
+      mcs_tas_accordin_direct_writer_event_post_leader(Storage());
+      return;
+    }
+    accordin_writer_event_post_leader(Storage());
+  }
+
+ private:
+  void* Storage() { return static_cast<void*>(storage_); }
+
+  Mutex* const mu_;
+  CvLabelStats* stats_ = nullptr;
+  bool active_ = false;
+  bool direct_ = false;
+  alignas(kWriterEventStorageAlign) unsigned char storage_[kWriterEventStorageSize];
+};
