+struct LockTimingThreadStats {
+  uint64_t hold_ns_total = 0;
+  uint64_t hold_samples = 0;
+};
+
+inline uint64_t LockTimingNowNs() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+inline std::atomic<bool>& LockTimingMeasurementActive() {
+  static std::atomic<bool> active(false);
+  return active;
+}
+
+inline std::atomic<uint64_t>& LockTimingMeasurementStartNs() {
+  static std::atomic<uint64_t> start_ns(0);
+  return start_ns;
+}
+
+inline std::atomic<uint64_t>& LockTimingMeasurementEndNs() {
+  static std::atomic<uint64_t> end_ns(0);
+  return end_ns;
+}
+
+inline std::atomic<uint64_t>& LockTimingBenchmarkElapsedNs() {
+  static std::atomic<uint64_t> elapsed_ns(0);
+  return elapsed_ns;
+}
+
+inline std::atomic<uint64_t>& LockTimingProcessHoldNsTotal() {
+  static std::atomic<uint64_t> hold_ns_total(0);
+  return hold_ns_total;
+}
+
+inline std::atomic<uint64_t>& LockTimingProcessHoldSamples() {
+  static std::atomic<uint64_t> hold_samples(0);
+  return hold_samples;
+}
+
+inline LockTimingThreadStats& LockTimingCurrentThreadStats() {
+  static thread_local LockTimingThreadStats stats;
+  return stats;
+}
+
+inline bool EnvFlagEnabled(const char* name, bool default_value) {
+  const char* value = std::getenv(name);
+  if (value == nullptr) {
+    return default_value;
+  }
+  const std::string setting(value);
+  return setting != "0" && setting != "false" && setting != "off" &&
+         setting != "no";
+}
+
+inline bool LockTimingEnabledByEnv() {
+  return EnvFlagEnabled("LEVELDB_LOCK_TIMING", true);
+}
+
+inline void FlushLockTimingThreadStats() {
+  LockTimingThreadStats& stats = LockTimingCurrentThreadStats();
+  if (stats.hold_ns_total != 0) {
+    LockTimingProcessHoldNsTotal().fetch_add(stats.hold_ns_total,
+                                             std::memory_order_relaxed);
+    stats.hold_ns_total = 0;
+  }
+  if (stats.hold_samples != 0) {
+    LockTimingProcessHoldSamples().fetch_add(stats.hold_samples,
+                                             std::memory_order_relaxed);
+    stats.hold_samples = 0;
+  }
+}
+
+inline void BeginLockTimingMeasurement() {
+  FlushLockTimingThreadStats();
+  LockTimingProcessHoldNsTotal().store(0, std::memory_order_relaxed);
+  LockTimingProcessHoldSamples().store(0, std::memory_order_relaxed);
+  LockTimingBenchmarkElapsedNs().store(0, std::memory_order_relaxed);
+  LockTimingMeasurementEndNs().store(0, std::memory_order_release);
+  LockTimingMeasurementStartNs().store(LockTimingNowNs(),
+                                       std::memory_order_release);
+  LockTimingMeasurementActive().store(true, std::memory_order_release);
+}
+
+inline void EndLockTimingMeasurement() {
+  const uint64_t end_ns = LockTimingNowNs();
+  LockTimingMeasurementActive().store(false, std::memory_order_release);
+  LockTimingMeasurementEndNs().store(end_ns, std::memory_order_release);
+  const uint64_t start_ns =
+      LockTimingMeasurementStartNs().load(std::memory_order_acquire);
+  LockTimingBenchmarkElapsedNs().store(
+      start_ns == 0 || end_ns < start_ns ? 0 : end_ns - start_ns,
+      std::memory_order_release);
+  FlushLockTimingThreadStats();
+}
+
+inline void RecordLockTimingHold(uint64_t hold_start_ns) {
+  if (hold_start_ns == 0) {
+    return;
+  }
+  uint64_t hold_end_ns = LockTimingNowNs();
+  if (!LockTimingMeasurementActive().load(std::memory_order_acquire)) {
+    const uint64_t measurement_end_ns =
+        LockTimingMeasurementEndNs().load(std::memory_order_acquire);
+    if (measurement_end_ns != 0 && hold_end_ns > measurement_end_ns) {
+      hold_end_ns = measurement_end_ns;
+    }
+  }
+  if (hold_end_ns <= hold_start_ns) {
+    return;
+  }
+  LockTimingThreadStats& stats = LockTimingCurrentThreadStats();
+  stats.hold_ns_total += hold_end_ns - hold_start_ns;
+  stats.hold_samples += 1;
+}
+
+inline void PrintLockTimingProcessStats() {
+  if (!LockTimingEnabledByEnv()) {
+    return;
+  }
+  FlushLockTimingThreadStats();
+  const uint64_t elapsed_ns =
+      LockTimingBenchmarkElapsedNs().load(std::memory_order_acquire);
+  const uint64_t hold_ns_total =
+      LockTimingProcessHoldNsTotal().load(std::memory_order_acquire);
+  const uint64_t hold_samples =
+      LockTimingProcessHoldSamples().load(std::memory_order_acquire);
+  const double avg_hold_ns =
+      hold_samples == 0
+          ? 0.0
+          : static_cast<double>(hold_ns_total) / static_cast<double>(hold_samples);
+  std::fprintf(stdout, "leveldb_lock_benchmark_elapsed_ns: %llu\n",
+               static_cast<unsigned long long>(elapsed_ns));
+  std::fprintf(stdout, "leveldb_lock_hold_ns_total: %llu\n",
+               static_cast<unsigned long long>(hold_ns_total));
+  std::fprintf(stdout, "leveldb_lock_hold_samples: %llu\n",
+               static_cast<unsigned long long>(hold_samples));
+  std::fprintf(stdout, "leveldb_lock_avg_hold_ns: %.2f\n", avg_hold_ns);
+  std::fflush(stdout);
+}
